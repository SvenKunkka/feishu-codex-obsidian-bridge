# No API keys, app secrets, chat exports or cookies belong in this repository.
# Copy to .env (gitignored). Existing process environment variables take precedence.

# Point this to an existing Obsidian vault, or open the default folder as a vault.
FEISHU_WIKI_VAULT=~/Documents/Feishu-WIKI
FEISHU_WIKI_STATE_DIR=~/.local/share/feishu-codex-obsidian-bridge

# Isolated from a pre-existing global bridge installation by default.
# LARK_CHANNEL_HOME=~/.local/share/feishu-codex-obsidian-bridge/lark-channel

# Optional command overrides; otherwise use PATH.
# BROWSER_USE_BIN=browser-use
# CODEX_BIN=codex
# YTDLP_BIN=yt-dlp
# CURL_BIN=curl

# Social summaries only; the chat model is configured in the bridge profile.
FEISHU_SUMMARY_MODEL=gpt-5.6-sol
FEISHU_SUMMARY_EFFORT=medium
# FEISHU_WIKI_RULES=/absolute/path/to/your/SKILL.md
